<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.account_matrix_notify</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='invoicing_settings']" position="after">
                <h2>Matrix</h2>
                <div class="row mt16 o_settings_container" id="matrix_notify_settings">
                    <div class="col-12 col-lg-6 o_setting_box" id="matrix_notify_enabled">
                        <div class="o_setting_left_pane">
                            <field name="matrix_notify_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="matrix_notify_enabled"/>
                            <span class="fa fa-lg fa-building-o" title="Valor específico de la empresa" groups="base.group_multi_company"/>
                            <div class="text-muted">
                                Enviar un mensaje a una sala de Matrix al validar facturas.
                                La conexión se configura en Ajustes generales › Integraciones.
                            </div>
                            <div class="content-group" attrs="{'invisible': [('matrix_notify_enabled', '=', False)]}">
                                <div class="row mt16">
                                    <label for="matrix_room" class="col-lg-4 o_light_label"/>
                                    <field name="matrix_room" placeholder="#facturas:matrix.example.org"
                                           attrs="{'required': [('matrix_notify_enabled', '=', True)]}"/>
                                </div>
                                <div class="mt8">
                                    <div><field name="matrix_notify_out_invoice" class="oe_inline"/> <label for="matrix_notify_out_invoice" class="o_light_label"/></div>
                                    <div><field name="matrix_notify_out_refund" class="oe_inline"/> <label for="matrix_notify_out_refund" class="o_light_label"/></div>
                                    <div><field name="matrix_notify_in_invoice" class="oe_inline"/> <label for="matrix_notify_in_invoice" class="o_light_label"/></div>
                                    <div><field name="matrix_notify_in_refund" class="oe_inline"/> <label for="matrix_notify_in_refund" class="o_light_label"/></div>
                                </div>
                                <div class="mt8" groups="base.group_system">
                                    <button name="action_matrix_test_invoice_room" type="object" class="btn-link"
                                            icon="fa-paper-plane" string="Enviar mensaje de prueba a la sala"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
